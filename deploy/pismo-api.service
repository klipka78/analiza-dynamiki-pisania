[Unit]
Description=Pismo keystroke API (FastAPI)
After=network.target

[Service]
Type=simple
User=a304500
Group=a304500
WorkingDirectory=/home/a304500/public_html/pismo/backend
EnvironmentFile=/home/a304500/public_html/pismo/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/a304500/public_html/pismo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
