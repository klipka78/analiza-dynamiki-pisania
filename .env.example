# === Konfiguracja produkcji (Docker) ===

DOMAIN=pismo.iit.sggw.pl
PUBLIC_URL=https://pismo.iit.sggw.pl

# Token panelu badacza (/admin) — ZMIEŃ przed startem
ADMIN_TOKEN=zmien-na-silne-haslo

APP_ENV=production

# Port na hoście (Apache ProxyPass na ten port)
HOST_PORT=8080
# Nasłuch tylko lokalnie (Apache na tym samym serwerze)
HOST_BIND=127.0.0.1

# SQLite w wolumenie Dockera (nie zmieniaj przy deployu Docker)
DATABASE_URL=sqlite:////data/keystroke.db

# Protokół badania / model
MIN_SESSIONS_PER_USER=3
MIN_USERS_FOR_MODEL=2
MIN_EVENTS=40
MIN_DURATION_MS=15000
CONFIDENCE_THRESHOLD=0.45
PROTOCOL_TASK_ID=A

