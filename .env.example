# Domena publiczna (bez https://)
DOMAIN=pismo.iit.sggw.pl

# Publiczny URL aplikacji (używany w CORS i linkach)
PUBLIC_URL=https://pismo.iit.sggw.pl

# Sekret do prostego panelu badacza (eksport / lista sesji)
ADMIN_TOKEN=zmien-na-silne-haslo

# Środowisko: development | production
APP_ENV=production

# Port HTTP na hoście (nginx w kontenerze)
HOST_PORT=80

# Baza (SQLite w wolumenie Docker — wystarczy na start pracy)
DATABASE_URL=sqlite:////data/keystroke.db
